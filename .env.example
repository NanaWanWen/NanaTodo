# AI Agent LLM API Keys
# 复制此文件为 .env 并填入实际 Key，然后启动后端时注入环境变量

# 通义千问（DashScope）- 默认提供商
# 申请地址：https://dashscope.aliyun.com
DASHSCOPE_API_KEY=请替换为你的真实Key，或使用本地 .env 文件（.env 已加入 .gitignore）

# 智谱 GLM（可选，与通义千问二选一）
# 申请地址：https://open.bigmodel.cn
ZHIPU_API_KEY=

# 切换提供商：dashscope（默认）或 zhipu
AGENT_LLM_PROVIDER=dashscope

# T+ Cloud 只读同步（默认关闭；真实密钥只放本机 .env）
TPLUS_ENABLED=false
TPLUS_DRY_RUN=true
# 云企业ID，统一用于 Token 获取和业务查询
TPLUS_ACCOUNT_ID=1243337607745442
TPLUS_APP_KEY=
TPLUS_APP_SECRET=
# 自建应用 Token 地址（已确认）
TPLUS_TOKEN_URL=https://openapi.chanjet.com/auth/v2/getToken
TPLUS_BASE_URL=https://openapi.chanjet.com
# 已由官方文档确认：T+ Cloud 往来单位分页查询
TPLUS_SUPPLIER_PATH=/tplus/api/v2/partner/QueryPage
# 以下接口必须使用 T+ 开放平台对应文档中的真实路径
TPLUS_MATERIAL_PATH=
TPLUS_PURCHASE_ORDER_PATH=
TPLUS_INVENTORY_PATH=
TPLUS_PAGE_SIZE=100
TPLUS_CONNECT_TIMEOUT_SECONDS=10
TPLUS_READ_TIMEOUT_SECONDS=30
TPLUS_MAX_RETRIES=2
TPLUS_SYNC_INTERVAL_MINUTES=10
TPLUS_SYNC_INTERVAL=PT10M
